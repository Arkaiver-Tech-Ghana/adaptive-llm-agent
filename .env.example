GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# WhatsApp Cloud API (Interface Layer / interfaces/whatsapp) — all three are
# process-wide, not per-Business: both test numbers live under one Meta
# App/WABA, so one App-level secret covers every Business it provisions a
# number for. See docs/adr/0005 if that assumption ever changes.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Optional overrides — all have working defaults, uncomment to change them.
# RATE_LIMIT_PER_MINUTE=20
# DEDUPE_TTL_SECONDS=86400
# BUSINESSES_DIR=businesses
# SESSION_DB_DIR=data
